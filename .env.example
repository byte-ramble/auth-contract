# ============================================================
# auth-contract BSC 部署环境配置
# ============================================================
# 复制为 .env 并填入实际值：
#   cp .env.example .env

# --- BSC RPC（主网或测试网）---
BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- 部署钱包（二选一，keystore 优先）---
# 方式 1：repo 专用 keystore 路径（生产推荐）
AUTH_DEPLOY_KEYSTORE_PATH=
# 兼容旧变量名（可选；若上面已填，这里可留空）
DEPLOY_KEYSTORE_PATH=
# 兼容 osw-contract 的变量名（可选；若上面已填，这里可留空）
OMNIX_DEPLOY_KEYSTORE_PATH=
# 方式 2：repo 专用直接私钥（仅测试用，勿提交到仓库）
AUTH_DEPLOY_PRIVATE_KEY=
# 兼容旧变量名（可选；若上面已填，这里可留空）
DEPLOY_PRIVATE_KEY=
# 兼容 osw-contract 的变量名（可选；若上面已填，这里可留空）
OMNIX_DEPLOY_PRIVATE_KEY=

# --- 合约参数 ---
# Owner 地址（部署后合约管理员）
OWNER=
# 单一 executor 地址（可选；部署/配置时若填写会自动 setExecutor）
EXECUTOR=
# Chainlink BNB/USD oracle 地址（BSC 主网）
BNB_USD_ORACLE=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
# Oracle 最大允许延迟（秒）
MAX_ORACLE_DELAY=3600
# 部署账户最小 BNB 余额（可选）
MIN_DEPLOYER_BNB=0.01

# --- 已部署合约地址（升级/配置时填写）---
PROXY_ADDRESS=

# --- Topic owner ops（PostDeployConfigure/setup-topic-expiry 用）---
TOPIC_KEY=
TOPIC_PRICE_WAD=
TOPIC_ANNUAL_PRICE_WAD=
EXPIRY_USER=
EXPIRY_TIMESTAMP=

# --- BSCScan 验证（部署后验证源码）---
BSCSCAN_API_KEY=

# --- PostDeployConfigure 选项 ---
# 是否配置 BSC 主网支付代币（WETH/USDT/USDC/WBNB/BTCB）
# 在 BSC testnet 上如不显式设置，deploy wrapper 会默认跳过
CONFIGURE_BSC_PAYMENT_TOKENS=true
# RAMBLE 折扣 bps；留空则 PostDeployConfigure 保留当前链上值（初始化默认 9000）
RAMBLE_DISCOUNT_BPS=
# 全局试用截止时间（Unix timestamp，留空跳过）
GLOBAL_TRIAL_ENDS_AT=
# 主题试用配置（逗号分隔，与 TOPIC_TRIAL_ENDS_ATS 一一对应）
TOPIC_TRIAL_KEYS=
TOPIC_TRIAL_ENDS_ATS=

# --- Membership payment owner tx preparation ---
# 生成 WETH/USDT/USDC/WBNB/BTCB/RAMBLE 支付配置交易；缺少 annual quote/topup 时可带升级交易
NEW_IMPLEMENTATION=
# RAMBLE/WBNB Pair 覆盖；留空使用 BSC 主网默认 Pair
RAMBLE_WBNB_PAIR=
# 输出路径；留空写入 deployments/prepared/membership-payments-<network>.json
MEMBERSHIP_TX_OUTPUT=

# ============================================================
# BSC 主网已知地址（仅供参考；PostDeployConfigure 主网 profile 会用到）
# ============================================================
# WETH  0x2170Ed0880ac9A755fd29B2688956BD959F933F8
# USDT  0x55d398326f99059fF775485246999027B3197955
# USDC  0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
# WBNB  0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
# BTCB  0x7130d2A12B9BCbFAe4f2634d864A1Ee1Ce3Ead9c
#
# Oracles:
# ETH/USD  0x9ef1B8c0E4F7dc8bF5719Ea496883DC6401d5b2e
# BTC/USD  0x264990fbd0A4796A3E3d8E37C4d5F87a3aCa5Ebf
# USDT/USD 0xB97Ad0E74fa7d920791E90258A6E2085088b4320
# USDC/USD 0x51597f405303C4377E36123cBc172b13269EA163
